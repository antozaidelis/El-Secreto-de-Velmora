  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: de1a192e5767897468d735d824f605e6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CombateManager
  panelDialogo: {fileID: 464547897}
  panelBatalla: {fileID: 128767552}
  retratoEnemigoChico: {fileID: 693583650}
  nombreEnemigoTexto: {fileID: 603640004}
  textoDialogo: {fileID: 1048241987}
  botonSkip: {fileID: 1429008190}
  nombreEnemigo: "Hur\xF3n del Pensamiento"
  frasesEnemigo:
  - "Las flores tiemblan...significa que el bosque ya te vio, peque\xF1o Chef."
  - "Este bosque guarda secretos que no te pertenecen, peque\xF1o chef. \nDa media
    vuelta antes de que la curiosidad te traiga problemas."
  - "Veo que quieres quedarte, est\xE1 bien, veamos si tus recetas son tan buenas
    como dicen."
  expresionesPorFrase:
  - {fileID: -5528957881967780351, guid: 99132671691abec4ab381b06bd9ec688, type: 3}
  - {fileID: 4424060610276751492, guid: d0f996a98f7b3b24ab7c26cd6609acb4, type: 3}
  - {fileID: 8800700007749426482, guid: 86ee8cd1fa113bc4385a1d45c19e2924, type: 3}
  globoDialogoBatalla: {fileID: 1857064399}
  textoGloboDialogoBatalla: {fileID: 119536331}
  frasesBatalla:
  - '"El pensamiento no se vence con fuerza."'
  - "\"Ya vi esa receta antes, m\xE1s de una vez.\""
  - "\"\xBFSab\xE9s por qu\xE9 luch\xE1s, o solo segu\xEDs el instinto?\""
  - "\"El bosque ense\xF1a paciencia. Vos todav\xEDa no.\""
  - "\"No es la sart\xE9n la que decide, sino quien la sostiene.\""
  - "\"Saber cu\xE1ndo retirarse tambi\xE9n es una forma de sabidur\xEDa.\""
  turnosMinimoEntreFrases: 2
  turnosMaximoEntreFrases: 1
  vidaJugadorMax: 100
  vidaEnemigoMax: 75
  textoVidaJugador: {fileID: 853875053}
